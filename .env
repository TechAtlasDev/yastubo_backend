# App
APP_NAME="Yastubo Backend"
APP_ENV="development"
DEBUG=True

# Database
DATABASE_URL="mysql+aiomysql://user:password@localhost:3306/yastubo"
DATABASE_URL_SYNC="mysql+pymysql://user:password@localhost:3306/yastubo"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
SECRET_KEY="super-secret-key-for-development"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
