# App
APP_NAME="Yastubo Backend"
APP_ENV="development"
DEBUG=True

# Database
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/yastubo"
DATABASE_URL_SYNC="postgresql+psycopg2://user:password@localhost:5432/yastubo"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
SECRET_KEY="super-secret-key-for-development"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID="ca_..."

# Feature flags
NOTIFICATIONS_ENABLED=False
WHATSAPP_ENABLED=False
CRM_ENABLED=False

# Email (SendGrid)
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@yastubo.com"
EMAIL_FROM_NAME="Yastubo"

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Zoho CRM
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_BASE_URL="https://www.zohoapis.com/crm/v3"

# URLs
FRONTEND_URL="http://localhost:3000"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
