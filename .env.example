# ─────────────────────────────────────────────
# YASTUBO BACKEND — Variables de Entorno
# Copia este archivo: cp .env.example .env
# ─────────────────────────────────────────────

# ── App ───────────────────────────────────────
APP_NAME="Yastubo Backend"
APP_ENV="development"         # development | staging | production
DEBUG=True

# ── Base de Datos (PostgreSQL) ────────────────
# Para Docker Compose usa: postgresql+asyncpg://user:password@postgres:5432/yastubo
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/yastubo"
DATABASE_URL_SYNC="postgresql+psycopg2://user:password@localhost:5432/yastubo"

# Credenciales usadas por docker-compose.yml
POSTGRES_DB="yastubo"
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"

# ── Redis ─────────────────────────────────────
# Para Docker Compose usa: redis://redis:6379
REDIS_URL="redis://localhost:6379"

# ── Seguridad / JWT ───────────────────────────
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="cambia-esto-en-produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Stripe ────────────────────────────────────
# Obtén tus claves en: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."       # stripe listen --print-secret
STRIPE_CONNECT_CLIENT_ID="ca_..."       # Para Stripe Connect (revendedores)

# ── Feature Flags de Integraciones ───────────
# Pon en True solo cuando tengas las credenciales reales configuradas
NOTIFICATIONS_ENABLED=False
WHATSAPP_ENABLED=False
CRM_ENABLED=False

# ── Email (SendGrid) ──────────────────────────
# Obtén tu API key en: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=""
EMAIL_FROM="noreply@yastubo.com"
EMAIL_FROM_NAME="Yastubo"

# ── WhatsApp (Twilio) ─────────────────────────
# Panel: https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ── Zoho CRM ──────────────────────────────────
# Genera tu refresh token en: https://api-console.zoho.com
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_BASE_URL="https://www.zohoapis.com/crm/v3"

# ── IA — Proveedores ─────────────────────────
# Google Gemini (Default): https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""
# OpenAI (Opcional): https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# ── WhatsApp / Chat (Chatwoot) ───────────────
# API Key del perfil de usuario en Chatwoot
CHATWOOT_API_KEY=""
CHATWOOT_BASE_URL="https://app.chatwoot.com"
# Número oficial asignado para la demo
CHATWOOT_PHONE_NUMBER="+12296006716"

# ── Voice AI — ElevenLabs ─────────────────────
# Obtén tu API key en: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"   # Rachel (voz por defecto)

# ── Automatización — n8n (Outbound) ───────────
# URL del webhook de n8n para disparar flujos externos
N8N_WEBHOOK_URL=""          # Fallback para todos los eventos
N8N_WEBHOOK_LEADS=""        # Solo CLIENT_* y LEAD_*
N8N_WEBHOOK_PAYMENTS=""     # Solo PAYMENT_*
N8N_WEBHOOK_POLICIES=""     # Solo POLICY_*

# ── Apple Wallet (Passbook) ───────────────────
# Rutas a los certificados de Apple Developer para generar .pkpass
APPLE_PASS_CERT_PATH=""
APPLE_PASS_KEY_PATH=""

# ── URLs ──────────────────────────────────────
FRONTEND_URL="http://localhost:3000"

# ── CORS ──────────────────────────────────────
# Lista de orígenes permitidos (separados por coma o formato JSON)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
